{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Copa de Campeones",
  "version": "0.1.0",
  "identifier": "com.copadecampeones.app",
  "build": {
    "frontendDist": "splash",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build && node scripts/prepare-tauri.mjs"
  },
  "app": {
    "windows": [
      {
        "title": "Copa de Campeones",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/node"],
    "resources": {
      "../.next/standalone": "server/"
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
